APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Port 5440 matches docker-compose.local.yml's db service. sslmode=disable
# because the local container has no SSL configured — golang-migrate's
# postgres driver defaults to requiring SSL, unlike libpq/pgx's "prefer".
DATABASE_URL=postgresql://postgres:password@localhost:5440/founderstack?sslmode=disable
# The API server's own runtime connection — RLS-restricted app_user, not
# the superuser above. See 000002_enable_rls.up.sql.
APP_DATABASE_URL=postgresql://app_user:app_password@localhost:5440/founderstack?sslmode=disable
# BYPASSRLS role for cross-tenant system contexts (Clerk webhook, future
# scheduler). See 000003_add_system_role.up.sql.
SYSTEM_DATABASE_URL=postgresql://app_system:app_system_password@localhost:5440/founderstack?sslmode=disable
DATABASE_POOL_SIZE=20

CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

LOCALSTACK_AUTH_TOKEN=ls-

PINECONE_API_KEY=pc-...
PINECONE_INDEX_RAG=founderstack-rag
PINECONE_INDEX_TOOLS=founderstack-tools

UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=

COHERE_API_KEY=co_...
# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`) — used
# directly as an AES-256-GCM key, not a Fernet key.
ENCRYPTION_KEY=your_base64_32_byte_key_here
ANTHROPIC_API_KEY_MOCK_PREFIX=sk-ant-test-

S3_BUCKET_DOCUMENTS=founderstack-documents
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_ENDPOINT_URL=http://localhost:4566

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# One Google Cloud OAuth app/client, shared by google_drive and
# google_calendar (different scopes requested per-provider). Drive scope
# must be drive.file, not drive/drive.readonly — see providers/google_drive.go.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn: register under the free "Share on LinkedIn" product
# (w_member_social) — not the paid, partner-gated Marketing Developer
# Platform, which this product has no use for.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

OAUTH_STATE_SECRET=

# Local-dev only — enables POST /api/v1/auth/dev-token. Leave unset in any
# real environment; the dev auth fallback is disabled whenever this is
# blank, regardless of APP_ENV.
DEV_TOKEN_SECRET=
